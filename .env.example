# ---------------------------------------------------------------
# Frontend-safe (exposed in the browser bundle via Vite's import.meta.env)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------
# SERVER-ONLY — used inside /api/*.js (Vercel serverless functions).
# NEVER prefix this with VITE_, never import it from src/, never commit
# the real value. In Vercel: Project Settings -> Environment Variables.
# ---------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------
# Optional — only needed if you swap the free OSRM demo router for a
# keyed provider later (e.g. OpenRouteService). Leave blank to use OSRM.
# ---------------------------------------------------------------
VITE_ROUTING_API_KEY=
